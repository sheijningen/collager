{
  "name": "collager",
  "version": "0.2.0",
  "description": "Media collage viewer for images (PNG/JPEG/WebP), GIFs and videos (MP4/WebM)",
  "private": true,
  "homepage": "https://github.com/sheijningen/collager",
  "repository": {
    "type": "git",
    "url": "https://github.com/sheijningen/collager.git"
  },
  "bugs": "https://github.com/sheijningen/collager/issues",
  "main": "src/main/main.js",
  "desktopName": "collager.desktop",
  "author": "Stefan Alexander van Heijningen",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "start": "node scripts/electron.js .",
    "test": "node --test \"test/main/*.test.js\" \"test/renderer/*.test.js\" \"test/scripts/*.test.js\"",
    "test:e2e": "node scripts/electron.js test/e2e/run.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.8.4",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "build": {
    "appId": "dev.svh.collager",
    "productName": "Collager",
    "files": [
      "src/**"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "afterPack": "./build/afterpack.js",
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": null,
      "fileAssociations": [
        {
          "ext": [
            "png",
            "jpg",
            "jpeg",
            "webp",
            "gif",
            "mp4",
            "webm"
          ],
          "name": "Media",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ],
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "LSItemContentTypes": [
              "public.folder"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "None"
          }
        ]
      },
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
    }
  }
}
